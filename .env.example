APP_NAME="Belinze Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

# PostgreSQL (recommended for Vercel — use Neon free tier: https://neon.tech)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Vercel serverless overrides (set these in Vercel dashboard → Settings → Env Vars)
CACHE_DRIVER=array
SESSION_DRIVER=cookie

ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password

VITE_APP_NAME="${APP_NAME}"
